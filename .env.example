# Public receiving address only. Never configure a private key.
ARC_SCOUT_PAY_TO=0xYOUR_DEDICATED_ARC_RECEIVING_ADDRESS
ARC_SCOUT_TOKEN_SCAN_PRICE=$0.005
X402_FACILITATOR_URL=https://facilitator.arcusnetwork.co

# Arc mainnet read-only sources.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_EXPLORER_API_URL=https://explorer.arc.io/api/v2
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex/tokens

# Optional durable storage. Configure real credentials only in your local or hosting environment.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_me

# Optional evidence registry keyed by exact contract address.
# ARC_SCOUT_OFFICIAL_REGISTRY_URL=https://your-service.example/api/official-evidence

# Local testing only. Never enable on public deployments.
ARC_SCOUT_ENABLE_DEV_SCAN=false
